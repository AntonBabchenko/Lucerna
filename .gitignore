# Claude Code — personal-scope settings and agent worktrees. The worktree roots
# hold full checkouts of this repository nested inside it, so without these
# rules a `git add -A` at the root stages an entire second working tree.
.claude/settings.local.json
/.claude-worktrees/
.claude/worktrees/

