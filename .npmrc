# Fail installs on peer-dep mismatches instead of silently accepting them.
# Per docs/PRINCIPLES.md: dependencies are deliberate.
strict-peer-dependencies=true

# Disable telemetry at the env level for any future tooling that respects these.
# Per docs/PRINCIPLES.md: no telemetry-collecting dev tooling.
# Most of our current deps (Svelte/Vite/Tailwind/Biome) do not phone home;
# setting these makes the principle explicit and future-proofs accidental additions.
ASTRO_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
GATSBY_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
