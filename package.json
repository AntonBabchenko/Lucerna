{
  "name": "ftlauncher",
  "version": "0.1.0",
  "description": "Clean, transparent Minecraft launcher (transparent).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "biome format --write . && prettier --write \"src/**/*.svelte\"",
    "lint": "biome check . && prettier --check \"src/**/*.svelte\" && node tools/check-no-network-calls.mjs",
    "lint:no-network": "node tools/check-no-network-calls.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.6.2",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
